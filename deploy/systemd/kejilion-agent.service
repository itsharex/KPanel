[Unit]
Description=KPanel Host Agent
Documentation=https://hub.docker.com/r/kjlion/kejilion-panel
After=local-fs.target

[Service]
Type=simple
User=root
Group=kejilion-panel
EnvironmentFile=-/etc/kejilion-panel/agent.env
ExecStart=/usr/local/libexec/kejilion-agent
Restart=on-failure
RestartSec=3s
RuntimeDirectory=kejilion-panel
RuntimeDirectoryMode=0750
# The Panel data directory is owned by the container UID/GID. Do not declare
# its parent as StateDirectory: systemd would recursively change that ownership.
UMask=0077

NoNewPrivileges=true
# Kejilion site trees may be owned by the script's invoking user. DAC override
# remains bounded to this service and the explicit writable paths below.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_MODULE CAP_NET_ADMIN CAP_SYS_RESOURCE CAP_DAC_OVERRIDE CAP_CHOWN CAP_LINUX_IMMUTABLE
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_MODULE CAP_NET_ADMIN CAP_SYS_RESOURCE CAP_DAC_OVERRIDE CAP_CHOWN CAP_LINUX_IMMUTABLE
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=false
ProtectKernelLogs=true
ProtectKernelModules=false
ProtectKernelTunables=false
# Docker socket activation guard verifies /run/docker.pid against /proc/<pid>/comm.
ProtectProc=default
ProtectSystem=strict
# The file manager is deliberately rooted at /home. ProtectHome=read-only wins
# over ReadWritePaths=/home on some systemd releases and makes every audited
# file mutation fail with EROFS. Keep the service root and protected data paths
# constrained below instead of making its managed root read-only.
ProtectHome=false
ReadOnlyPaths=/var/lib/kejilion-panel/panel
# System actions need atomic rename transactions below /etc. The application
# market and file manager write only through audited, fixed Agent adapters.
# The file manager is rooted at /home and independently rejects KPanel data paths.
ReadWritePaths=/run/kejilion-panel /var/lib/kejilion-panel/system /var/lib/kejilion-panel/wordpress-jobs /var/lib/kejilion-panel/site-recipe-jobs /var/lib/kejilion-panel/app-jobs /var/lib/kejilion-panel/diagnostic-jobs /var/lib/kejilion-panel/docker-jobs /var/lib/kejilion-panel/site-icons /home /etc
# iptables-nft talks to the kernel through netlink. Keep that family available
# so Docker access rules work inside the otherwise restricted service sandbox.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service @module @swap sethostname
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
