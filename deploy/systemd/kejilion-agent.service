[Unit]
Description=Kejilion Panel Host Agent
Documentation=https://github.com/kejilion/kejilion-panel
After=local-fs.target

[Service]
Type=simple
User=root
Group=kejilion-panel
EnvironmentFile=-/etc/kejilion-panel/agent.env
ExecStart=/usr/local/libexec/kejilion-agent
Restart=on-failure
RestartSec=3s
RuntimeDirectory=kejilion-panel
RuntimeDirectoryMode=0750
StateDirectory=kejilion-panel
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/kejilion-panel /var/lib/kejilion-panel -/home/web/conf.d -/home/web/html
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
