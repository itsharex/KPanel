[Unit]
Description=KPanel Host Agent
Documentation=https://github.com/kejilion/kejilion-panel
After=local-fs.target

[Service]
Type=simple
User=root
Group=kejilion-panel
EnvironmentFile=-/etc/kejilion-panel/agent.env
ExecStart=/usr/local/libexec/kejilion-agent
Restart=on-failure
RestartSec=3s
RuntimeDirectory=kejilion-panel
RuntimeDirectoryMode=0750
# The Panel data directory is owned by the container UID/GID. Do not declare
# its parent as StateDirectory: systemd would recursively change that ownership.
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
# Docker socket activation guard verifies /run/docker.pid against /proc/<pid>/comm.
ProtectProc=default
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/kejilion-panel
ReadWritePaths=/run/kejilion-panel -/home/web/conf.d -/home/web/html
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
