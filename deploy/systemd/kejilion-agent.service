[Unit]
Description=KPanel Host Agent
Documentation=https://hub.docker.com/r/kjlion/kejilion-panel
After=local-fs.target

[Service]
Type=simple
User=root
Group=kejilion-panel
EnvironmentFile=-/etc/kejilion-panel/agent.env
ExecStart=/usr/local/libexec/kejilion-agent
Restart=on-failure
RestartSec=3s
RuntimeDirectory=kejilion-panel
RuntimeDirectoryMode=0750
# The Panel data directory is owned by the container UID/GID. Do not declare
# its parent as StateDirectory: systemd would recursively change that ownership.
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_MODULE CAP_NET_ADMIN CAP_SYS_RESOURCE
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_MODULE CAP_NET_ADMIN CAP_SYS_RESOURCE
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=false
ProtectKernelLogs=true
ProtectKernelModules=false
ProtectKernelTunables=false
# Docker socket activation guard verifies /run/docker.pid against /proc/<pid>/comm.
ProtectProc=default
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/kejilion-panel/panel
# System actions need atomic rename transactions below /etc. The application
# market writes only audited appno/port compatibility files below /home/docker;
# container changes remain constrained by fixed declarative adapters.
ReadWritePaths=/run/kejilion-panel /var/lib/kejilion-panel/system /var/lib/kejilion-panel/wordpress-jobs /var/lib/kejilion-panel/app-jobs -/home/web/conf.d -/home/web/html -/home/web/certs -/home/web/letsencrypt -/home/docker /etc
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service @module @swap sethostname
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
