KEJILION_AGENT_SOCKET=/run/kejilion-panel/agent.sock
KEJILION_AGENT_TOKEN_FILE=/etc/kejilion-panel/agent.token
KEJILION_AGENT_STATE_DIR=/var/lib/kejilion-panel
KEJILION_WEB_ROOT=/home/web
KEJILION_DOCKER_SOCKET=/var/run/docker.sock
KEJILION_DOCKER_PID_FILE=/run/docker.pid
# Keep false so merely starting or polling the Agent cannot socket-activate dockerd.
KEJILION_DOCKER_ALLOW_SOCKET_ACTIVATION=false
# Typed system actions only; no arbitrary shell or command endpoint is exposed.
KEJILION_SYSTEM_WRITES_ENABLED=true
