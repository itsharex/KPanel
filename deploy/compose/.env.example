# Use an immutable release tag or digest in production.
KEJILION_PANEL_IMAGE=example.invalid/kejilion-panel:v0.1.0

# Run on the host: getent group kejilion-panel | cut -d: -f3
KEJILION_PANEL_GID=1000

# The panel only binds localhost by default. Put HTTPS reverse proxy in front.
KEJILION_PANEL_PORT=18443
KEJILION_PANEL_PUBLIC_URL=https://panel.example.com
KEJILION_PANEL_SECURE_COOKIE=true

